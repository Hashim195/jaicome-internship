    "@jaicome-internship/env": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "ai": "^6.0.177",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "nanoid": "^5.1.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jaicome-internship/config": "workspace:*",
    "@types/bun": "catalog:",
